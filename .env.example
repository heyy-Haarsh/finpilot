# Copy to .env for docker compose. Never commit .env.
DB_USERNAME=postgres
DB_PASSWORD=change_me

# At least 32 characters (HMAC-SHA256 key)
JWT_SECRET=change_me_to_a_random_string_of_32_plus_chars

MARKETDATA_API_KEY=your_alpha_vantage_api_key

# Defaults to Ollama on the host; set these for OpenAI/Groq instead
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your_ai_api_key
